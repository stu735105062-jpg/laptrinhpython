@startuml
class BieuMauNhapLieu {
    +ten_cong_viec: StringVar
    +mo_ta_cong_viec: StringVar
    +ngay_het_han: StringVar
    +gio: StringVar
    +phut: StringVar
    +quan_trong: StringVar
    +tao_o_nhap_lieu(nhan, bien)
    +tao_o_mo_ta(nhan, bien)
    +tao_chon_ngay()
    +tao_chon_gio()
    +tao_o_check_quan_trong()
    +tao_hop_nut_bam()
}

class HopThoaiChonNgay {
    +cha: Misc
    +goc: Toplevel
    +ngay_dau_tuan: int
    +ngay_bat_dau: date
    +phong_cach: str
    +vo_hieu_hoa_qua_khu: bool
    +ngay_da_chon: date
    +_thiet_lap_lich()
}

class CoSoDuLieu {
    +ket_noi()
    +ghi(du_lieu_cong_viec)
    +doc()
    +xoa(id_xoa)
    +cap_nhat(id_sua, cong_viec, mo_ta, ngay, gio, trang_thai, quan_trong)
    +lay_cong_viec_theo_ngay(ngay)
}

Chinh -- BieuMauNhapLieu : su_dung
Chinh -- HopThoaiChonNgay : su_dung
Chinh -- CoSoDuLieu : su_dung
BieuMauNhapLieu -- HopThoaiChonNgay : su_dung
BieuMauNhapLieu -- CoSoDuLieu : su_dung
@enduml
